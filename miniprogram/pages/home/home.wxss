/* 会员首页(原生) —— 视觉与 H5 首页(server/web/m 的 .mh-*)保持一致 */
page { background: #F4F4F4; color: #333; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif; }
.page { min-height: 100vh; }
.tap { opacity: .6; }

/* 首屏视频 */
.hero { position: relative; overflow: hidden; background: #0b0b0b; }
.hv { position: absolute; left: 0; top: 0; width: 100%; height: 100%; opacity: 0; transition: opacity .9s ease; }
.hv.on { opacity: 1; }
.hposter { position: absolute; left: 0; top: 0; width: 100%; height: 100%; transition: opacity .6s ease; }
.hposter.hide { opacity: 0; }
.shade { position: absolute; left: 0; top: 0; right: 0; bottom: -1px; z-index: 1; pointer-events: none;
  background:
    linear-gradient(180deg, rgba(0,0,0,.55) 0%, rgba(0,0,0,0) 26%),
    radial-gradient(ellipse 75% 32% at 50% 42%, rgba(0,0,0,.38), rgba(0,0,0,0) 72%),
    linear-gradient(180deg, rgba(244,244,244,0) 86%, rgba(244,244,244,.28) 94%, #F4F4F4 99.5%, #F4F4F4 100%); }
.top { position: absolute; left: 16px; z-index: 3; display: flex; align-items: center; color: #fff; }
.avatar { width: 32px; height: 32px; border-radius: 50%; flex-shrink: 0; display: flex; align-items: center; justify-content: center;
  font-size: 14px; font-weight: 600; background: rgba(255,255,255,.16); border: 1px solid rgba(255,255,255,.5); }
/* AI 助手机器人入口: 白底圆形 + 轻微呼吸浮动 + 荧光绿光圈 */
.bot-wrap { position: relative; width: 36px; height: 36px; flex-shrink: 0; border-radius: 50%; background: #fff;
  box-shadow: 0 0 0 2px rgba(182,255,59,.55), 0 2px 10px rgba(0,0,0,.35); animation: bot-float 2.6s ease-in-out infinite; }
.bot { width: 36px; height: 36px; border-radius: 50%; display: block; }
.bot-dot { position: absolute; right: -1px; top: -1px; width: 9px; height: 9px; border-radius: 50%; background: #ff3b30; border: 1.5px solid #fff; }
@keyframes bot-float {
  0%, 100% { transform: translateY(0); box-shadow: 0 0 0 2px rgba(182,255,59,.55), 0 2px 10px rgba(0,0,0,.35); }
  50% { transform: translateY(-2px); box-shadow: 0 0 0 4px rgba(182,255,59,.25), 0 4px 12px rgba(0,0,0,.3); }
}
.hi { flex: 1; min-width: 0; margin-left: 9px; }
.hello { font-size: 15px; font-weight: 700; line-height: 1.25; text-shadow: 0 1px 6px rgba(0,0,0,.35); }
.next { font-size: 11px; opacity: .88; line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.vip { flex-shrink: 0; margin-left: 8px; font-size: 11px; font-weight: 600; padding: 3px 11px; border-radius: 999px; background: rgba(255,255,255,.94); color: #111; }
.brand { position: absolute; left: 0; right: 0; top: 52%; transform: translateY(-50%); z-index: 3; text-align: center; color: #fff; }
.logo { display: block; width: 176px; max-width: 46%; margin: 0 auto; }
.slogan { margin-top: 12px; font-size: 12px; letter-spacing: 4px; padding-left: 4px; opacity: .92; text-shadow: 0 1px 6px rgba(0,0,0,.45); }
.vdots { display: flex; justify-content: center; margin-top: 14px; }
.vdots .d { width: 5px; height: 5px; margin: 0 2.5px; border-radius: 3px; background: rgba(255,255,255,.45); transition: width .3s; }
.vdots .d.on { width: 14px; background: #fff; }

/* 双入口卡 */
.entry { position: relative; z-index: 3; margin: -58px 12px 0; display: flex; align-items: center; padding: 18px 0 16px;
  background: #fff; border-radius: 16px; box-shadow: 0 6px 24px rgba(0,0,0,.06); }
.entry-item { flex: 1; min-width: 0; text-align: center; }
.entry-item .en { font-size: 11px; letter-spacing: 1px; color: #555; font-weight: 500; }
.entry-item .cn { font-size: 23px; font-weight: 700; letter-spacing: 1px; color: #111; margin-top: 4px; }
.entry-item .sub { font-size: 11px; color: #b4b4b4; margin-top: 5px; }
.entry-split { width: 1px; height: 52px; background: #ececec; flex-shrink: 0; }

/* 黑色会员条 */
.club { margin: 12px 12px 0; border-radius: 14px; overflow: hidden; background: #fff; }
.club-bar { display: flex; align-items: center; padding: 11px 14px; background: #000; color: #fff; font-size: 13.5px; }
.club-txt { flex: 1; min-width: 0; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.club-act { flex-shrink: 0; margin-left: 10px; font-size: 12.5px; }
.club-sub { display: flex; align-items: center; padding: 10px 14px 2px; font-size: 12.5px; color: #222; }
.club-sub-txt { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.club-sub-more { flex-shrink: 0; margin-left: 8px; font-size: 12px; color: #999; }
.club-body { padding: 10px 10px 12px; }
.icons { width: 100%; white-space: nowrap; border-radius: 12px; background: #f7f7f7; }
.icons-row { display: flex; padding: 16px 2px 12px; }
.ic { flex: 0 0 25%; min-width: 74px; text-align: center; }
.ic-c { position: relative; width: 44px; height: 44px; margin: 0 auto; border-radius: 50%; background: #fff; display: flex; align-items: center; justify-content: center; }
.ic-i { width: 22px; height: 22px; }
.ic-tag { position: absolute; top: -8px; left: 28px; white-space: nowrap; font-size: 9.5px; line-height: 15px; padding: 0 5px; font-weight: 600;
  border-radius: 8px 8px 8px 2px; background: #ee0a24; color: #fff; }
.ic .t { font-size: 13px; font-weight: 500; color: #111; margin-top: 8px; }
.ic .s { font-size: 10.5px; color: #b4b4b4; margin-top: 3px; }
.track { width: 36px; height: 3px; margin: 10px auto 0; border-radius: 2px; background: #ececec; overflow: hidden; }
.thumb { height: 100%; border-radius: 2px; background: #111; }
.more { text-align: center; font-size: 12px; letter-spacing: 1px; color: #b4b4b4; padding: 14px 0 8px; margin-bottom: calc(60px + env(safe-area-inset-bottom) * .2); }

/* 第二屏 */
.pending { margin: 10px 12px; background: #000; color: #fff; border-radius: 14px; padding: 10px 12px; font-size: 13px; display: flex; align-items: center; }
.pending-i { width: 18px; height: 18px; flex-shrink: 0; }
.pending-t { flex: 1; margin-left: 10px; }
.sec-title { font-size: 15px; font-weight: 600; color: #111; margin: 16px 14px 8px; display: flex; align-items: center; justify-content: space-between; }
.sec-more { font-size: 12px; color: #7c7c7c; font-weight: 400; }
.banners { height: 150px; margin: 0 12px; border-radius: 14px; overflow: hidden; transform: translateZ(0); }
.banner { position: relative; height: 150px; border-radius: 14px; overflow: hidden; padding: 0 22px; box-sizing: border-box;
  display: flex; flex-direction: column; justify-content: center; color: #fff; background-color: #000; }
.banner-wm { position: absolute; right: 14px; top: 12px; width: 64px; height: 36px; opacity: .32; }
.banner-txt { position: relative; max-width: 58%; }
.bt { font-size: 20px; font-weight: 800; line-height: 1.22; letter-spacing: .5px; text-shadow: 0 2px 10px rgba(0,0,0,.45); }
.bs { margin-top: 9px; font-size: 11.5px; color: rgba(255,255,255,.72); display: flex; align-items: center; white-space: nowrap; overflow: hidden; }
.bs .hl { color: #fff; border: 1px solid rgba(255,255,255,.6); border-radius: 4px; padding: 0 5px; font-weight: 600; margin-right: 6px; flex-shrink: 0; }
.bs .tx { overflow: hidden; text-overflow: ellipsis; }
.banner-cta { position: absolute; right: 14px; bottom: 14px; background: #fff; color: #111; font-size: 12.5px; font-weight: 700;
  padding: 6px 14px; border-radius: 999px; box-shadow: 0 4px 14px rgba(0,0,0,.28); }
.notice { margin: 12px 12px 0; background: #fff; border-radius: 12px; padding: 0 14px; }
.notice-row { display: flex; align-items: center; padding: 12px 0; font-size: 14px; }
.notice-row + .notice-row { border-top: 1px solid #f2f2f2; }
.notice-t { flex: 1; min-width: 0; color: #333; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.notice-d { font-size: 12px; color: #b4b4b4; margin: 0 6px; }
.arrow { color: #b4b4b4; }

/* 会员卡: 全幅视频首帧背景加深 + 磨砂半透明质感 + Logo 水印 */
.cards { width: 100%; white-space: nowrap; }
.cards-row { display: flex; padding: 4px 12px 10px; }
.face { position: relative; flex: 0 0 264px; width: 264px; min-height: 116px; margin-right: 10px; border-radius: 16px; padding: 14px 16px;
  box-sizing: border-box; color: #fff; overflow: hidden; white-space: normal;
  box-shadow: 0 8px 22px rgba(0,0,0,.18), inset 0 1px 0 rgba(255,255,255,.22), inset 0 0 0 1px rgba(255,255,255,.08); }
.face-wm { position: absolute; right: -16px; bottom: -14px; width: 128px; height: 72px; opacity: .14; transform: rotate(-10deg); }
.face .kind { position: relative; display: inline-block; font-size: 11px; font-weight: 600; letter-spacing: .5px;
  border: 1px solid rgba(255,255,255,.28); border-radius: 999px; padding: 2px 9px;
  background: rgba(255,255,255,.16); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
.face .name { position: relative; font-size: 16px; font-weight: 700; margin-top: 8px; text-shadow: 0 2px 8px rgba(0,0,0,.55); }
.face .left { position: relative; font-size: 13px; margin-top: 10px; text-shadow: 0 1px 6px rgba(0,0,0,.5); }
.face .exp { position: relative; font-size: 11px; opacity: .82; margin-top: 4px; text-shadow: 0 1px 4px rgba(0,0,0,.45); }
.face.dead .face-wm { opacity: .22; }
.face-add { flex: 0 0 132px; width: 132px; min-height: 108px; border-radius: 14px; border: 1.5px dashed #b4b4b4; background: #fff; color: #111;
  display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 13px; box-sizing: border-box; }
.face-add-i { width: 20px; height: 20px; margin-bottom: 6px; }
.nocard { margin: 0 12px; background: #fff; border-radius: 12px; padding: 14px; display: flex; align-items: center; font-size: 14px; }
.nocard-t { flex: 1; }
.nocard-btn { background: #000; color: #fff; font-size: 12px; padding: 5px 14px; border-radius: 999px; }

/* 悬浮底部导航 */
.tab-space { height: calc(100px + env(safe-area-inset-bottom)); }
.tabbar { position: fixed; z-index: 120; left: 16px; right: 16px; bottom: calc(8px + env(safe-area-inset-bottom) * .18); height: 56px;
  border-radius: 999px; background: #fff; box-shadow: 0 4px 20px rgba(0,0,0,.07); display: flex; }
.tab { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 12px; color: #b4b4b4; }
.tab.on { color: #000; font-weight: 600; }
.tab-i { width: 20px; height: 20px; margin-bottom: 3px; }
/* 视频层底边在部分机型会露出 1px 细线, 用页面底色压住 */
.hero::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: #F4F4F4; z-index: 2; }
